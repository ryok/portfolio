---
import type { Project } from '../utils/loadData';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const artProjects = projects.filter(p => p.type === 'art');
const base = import.meta.env.BASE_URL;
---

<section id="gallery" class="section">
  <div class="container">
    <h2 class="section-title">Gallery</h2>
    <div class="gallery-grid">
      {artProjects.map(p => (
        <a href={p.url} target="_blank" rel="noopener" class="gallery-item glass">
          {p.image && (
            <div class="gallery-image">
              <img src={`${base}/images/${p.image}`} alt={p.name} loading="lazy" />
            </div>
          )}
          <div class="gallery-info">
            <h3>{p.name}</h3>
            <p>{p.description}</p>
            <div class="gallery-tags">
              {p.tags.map(tag => <span class="tag">{tag}</span>)}
            </div>
          </div>
        </a>
      ))}
    </div>
    <p class="gallery-note">
      AV作品はアーティスト名義 RIOKADA で発表しています → <a href="https://riokada.com" target="_blank" rel="noopener">riokada.com</a>
    </p>
  </div>
</section>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .gallery-item {
    display: block;
    overflow: hidden;
    color: var(--text-primary);
  }

  .gallery-item:hover {
    color: var(--text-primary);
  }

  .gallery-note {
    margin-top: 20px;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .gallery-image {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .gallery-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition);
  }

  .gallery-item:hover .gallery-image img {
    transform: scale(1.05);
  }

  .gallery-info {
    padding: 16px;
  }

  .gallery-info h3 {
    font-size: 0.95rem;
    margin-bottom: 4px;
  }

  .gallery-info p {
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-bottom: 8px;
  }

  .gallery-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  @media (max-width: 768px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .gallery-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
