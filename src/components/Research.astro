---
import type { Research } from '../utils/loadData';

interface Props {
  publications: Research[];
}

const { publications } = Astro.props;

---

<section id="research" class="section">
  <div class="container">
    <h2 class="section-title">Research Publications</h2>
    <div class="research-list">
      {publications.map(pub => (
        <a href={pub.url || '#'} target="_blank" rel="noopener" class="research-item glass">
          <div class="research-venue">{pub.venue}</div>
          <h3>{pub.title}</h3>
          {pub.authors ? (
            <p class="research-authors">
              {pub.authors.split(', ').map((name, i) => (
                <>{i > 0 && ', '}{name === '岡田領' ? <strong>{name}</strong> : name}</>
              ))}
            </p>
          ) : pub.coauthors && (
            <p class="research-authors">
              <strong>Ryo Okada</strong>, {pub.coauthors.join(', ')}
            </p>
          )}
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .research-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .research-item {
    display: block;
    padding: 20px 24px;
    color: var(--text-primary);
  }

  .research-item:hover {
    color: var(--text-primary);
  }

  .research-venue {
    font-size: 0.75rem;
    color: var(--accent-purple);
    font-family: 'JetBrains Mono', monospace;
    margin-bottom: 6px;
  }

  .research-item h3 {
    font-size: 1rem;
    font-weight: 500;
    margin-bottom: 6px;
  }

  .research-authors {
    font-size: 0.8rem;
    color: var(--text-secondary);
  }
</style>
