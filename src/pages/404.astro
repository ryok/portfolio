---
import BaseLayout from '../layouts/BaseLayout.astro';
import CosmicNetwork from '../components/CosmicNetwork.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Page not found - Ryo Okada">
  <section class="section not-found">
    <div class="container">
      <h1 class="section-title">404</h1>
      <p>This page doesn't exist. It may have moved when the site switched to ryookada.dev.</p>
      <a href={base} class="home-link">← Back to ryookada.dev</a>
    </div>
  </section>
  <CosmicNetwork />
</BaseLayout>

<style>
  .not-found {
    min-height: 100vh;
    display: flex;
    align-items: center;
  }

  .not-found p {
    color: var(--text-secondary);
    margin-bottom: 24px;
  }

  .home-link {
    font-family: 'JetBrains Mono', monospace;
  }
</style>
